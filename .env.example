# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SPREADSHEET_ID: ID de la hoja principal McM en Google Sheets.
SPREADSHEET_ID="1UnWSSYLEHfrdmX21NipwdjcRJ9xWr-vo1GfM-o2QqeE"

# SESSION_SECRET: Clave secreta para firmar cookies de sesión RBAC en el servidor.
SESSION_SECRET="cambia-esta-clave-secreta-en-produccion"

# GOOGLE_SERVICE_ACCOUNT_JSON: JSON completo de la Cuenta de Servicio de Google Cloud (opcional si usas APPS_SCRIPT_URL).
GOOGLE_SERVICE_ACCOUNT_JSON=""

# APPS_SCRIPT_URL: URL /exec de la Web App de Google Apps Script (permite acceso 24/7 con hoja USUARIOS sin archivo JSON).
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycby6ay6s4W3n0mh2xC34d8YHHiyRO6aUigcE0lvUt_6GgZ8JpO2fVroLHajpfEL5IOYoeA/exec"
